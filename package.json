{
  "name": "preproute",
  "version": "0.1.0",
  "description": "Preproute admin test management application built with Next.js, React, TypeScript, and the provided staging APIs.",
  "private": true,
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint app components hooks lib next.config.ts",
    "typecheck": "tsc --noEmit",
    "check": "eslint app components hooks lib next.config.ts && tsc --noEmit",
    "test:csv": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON lib/csv-question-import.test.ts",
    "verify": "eslint app components hooks lib next.config.ts && tsc --noEmit && next build"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.4.0",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.23.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.80.0",
    "shadcn": "^4.12.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
